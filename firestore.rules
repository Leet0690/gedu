rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function profile() { return get(/databases/$(database)/documents/users/$(request.auth.uid)).data; }
    function active() { return request.auth != null && profile().isActive == true; }
    function admin() { return active() && profile().role in ['admin', 'super_admin']; }
    function permitted(module, level) {
      return active() && (admin() || ((module != 'users' || profile().permissions.get('finance', 'none') == 'none') &&
        (profile().permissions.get(module, 'none') == 'edit' ||
          (level == 'view' && profile().permissions.get(module, 'none') == 'view'))));
    }
    function userManager() { return permitted('users', 'edit'); }
    function manageable(u) {
      return admin() || (userManager() && u.role in ['director', 'secretary', 'instructor', 'custom'] && u.permissions.get('finance', 'none') == 'none');
    }
    function validPermissions(p) {
      return p is map && p.keys().hasOnly(['dashboard', 'students', 'teachers', 'continuous', 'finance', 'modules', 'grades', 'reports', 'schedules', 'schedule_generation', 'attendance_students', 'attendance_teachers', 'logs', 'users', 'catalog']) &&
        p.dashboard in ['none', 'view', 'edit'] && p.students in ['none', 'view', 'edit'] &&
        p.teachers in ['none', 'view', 'edit'] && p.continuous in ['none', 'view', 'edit'] &&
        p.finance in ['none', 'view', 'edit'] && p.modules in ['none', 'view', 'edit'] &&
        p.grades in ['none', 'view', 'edit'] && p.reports in ['none', 'view', 'edit'] &&
        p.schedules in ['none', 'view', 'edit'] && p.schedule_generation in ['none', 'view', 'edit'] &&
        p.attendance_students in ['none', 'view', 'edit'] && p.attendance_teachers in ['none', 'view', 'edit'] &&
        p.logs in ['none', 'view', 'edit'] && p.users in ['none', 'view', 'edit'] && p.get('catalog', 'none') in ['none', 'view', 'edit'];
    }
    function validUser(uid) {
      let u = request.resource.data;
      return u.uid == uid && u.email is string && u.displayName is string && u.displayName.size() > 0 && u.displayName.size() <= 160 &&
        u.isActive is bool && u.role in ['admin', 'super_admin', 'director', 'secretary', 'instructor', 'custom'] &&
        validPermissions(u.permissions) && (u.role in ['admin', 'super_admin'] || u.permissions.users == 'none' || u.permissions.finance == 'none');
    }
    match /users/{uid} {
      // Missing/inactive users may read only their own profile to show a useful login error.
      allow get: if request.auth != null && (request.auth.uid == uid || permitted('users', 'view'));
      allow list: if permitted('users', 'view');
      allow create: if userManager() && manageable(request.resource.data) && validUser(uid) && request.resource.data.createdAt == request.time &&
        request.resource.data.keys().hasOnly(['uid', 'email', 'displayName', 'role', 'permissions', 'isActive', 'createdAt', 'lastLogin']);
      allow update: if (active() && request.auth.uid == uid &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastLogin']) && request.resource.data.lastLogin == request.time)
        || (userManager() && manageable(resource.data) && manageable(request.resource.data) && validUser(uid) && request.resource.data.updatedAt == request.time &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName', 'role', 'permissions', 'isActive', 'updatedAt']) &&
          (request.auth.uid != uid || request.resource.data.isActive == true) &&
          (!(resource.data.isActive == true && resource.data.role in ['admin', 'super_admin']) ||
            (request.resource.data.isActive == true && request.resource.data.role == resource.data.role)));
      allow delete: if false;
    }
    function attributed() {
      return active() && request.resource.data.userId == request.auth.uid &&
        request.resource.data.userName == profile().displayName &&
        request.resource.data.userRole == profile().role && request.resource.data.createdAt == request.time;
    }
    function validClassAttendanceActivity(id) {
      let data = request.resource.data;
      let metadata = data.metadata;
      let teacher = get(/databases/$(database)/documents/teachers/$(metadata.teacherId)).data;
      let schedule = get(/databases/$(database)/documents/schedules/$(metadata.scheduleId)).data;
      let before = get(/databases/$(database)/documents/attendance_formateurs/$(metadata.teacherAttendanceId)).data;
      let after = getAfter(/databases/$(database)/documents/attendance_formateurs/$(metadata.teacherAttendanceId)).data;
      return data.keys().hasAll(['userId', 'userName', 'userRole', 'message', 'type', 'actionType', 'module', 'metadata', 'timestamp', 'createdAt']) &&
        data.keys().hasOnly(['userId', 'userName', 'userRole', 'message', 'type', 'actionType', 'module', 'metadata', 'timestamp', 'createdAt']) &&
        metadata.keys().hasAll(['teacherId', 'scheduleId', 'teacherAttendanceId', 'date', 'major', 'year', 'timeSlot']) &&
        metadata.keys().hasOnly(['teacherId', 'scheduleId', 'teacherAttendanceId', 'date', 'major', 'year', 'timeSlot']) &&
        metadata.teacherId is string && metadata.scheduleId is string && metadata.teacherAttendanceId is string &&
        metadata.date is string && metadata.date.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') &&
        id == 'teacher-attendance-' + metadata.scheduleId + '-' + metadata.date &&
        data.userId == 'teacher:' + metadata.teacherId && data.userName == teacher.name && data.userRole == 'formateur' &&
        data.actionType == 'CLASS_ATTENDANCE_COMPLETED' && data.module == 'attendance_students' && data.type == 'success' &&
        data.message == teacher.name + ' a pris la présence de la classe ' + schedule.filiere + ' (' + schedule.annee + ').' &&
        data.timestamp == request.time && data.createdAt == request.time &&
        schedule.teacherId == metadata.teacherId && schedule.filiere == metadata.major && schedule.annee == metadata.year &&
        schedule.time == metadata.timeSlot && before.teacherId == metadata.teacherId && before.date == metadata.date &&
        before.status == 'present' && after.teacherId == metadata.teacherId && after.date == metadata.date &&
        after.status == 'present' && after.timeSlot == metadata.timeSlot && after.timestamp == request.time &&
        teacher.tokenAttendance == after.tokenAttendance &&
        before.get('classAttendanceEvents', {}).get(id, false) == false &&
        after.get('classAttendanceEvents', {}).get(id, false) == true;
    }
    match /activity_logs/{id} {
      allow read: if permitted('logs', 'view') || (active() && resource.data.userId == request.auth.uid) ||
        (permitted('dashboard', 'view') && resource.data.actionType == 'CLASS_ATTENDANCE_COMPLETED');
      allow create: if validClassAttendanceActivity(id);
      allow create: if !id.matches('server-.*') && !id.matches('teacher-attendance-.*') &&
        request.resource.data.get('actionType', '') != 'CLASS_ATTENDANCE_COMPLETED' &&
        attributed() && request.resource.data.timestamp == request.time &&
        request.resource.data.message is string && request.resource.data.message.size() <= 2000 &&
        request.resource.data.keys().hasOnly(['userId', 'userName', 'userRole', 'message', 'type', 'actionType', 'module', 'metadata', 'timestamp', 'createdAt']);
      allow update, delete: if false;
    }
    match /access_logs/{id} {
      allow read: if permitted('logs', 'view');
      allow create: if attributed() && request.resource.data.keys().hasOnly(['userId', 'userName', 'userRole', 'ipAddress', 'deviceName', 'browser', 'os', 'deviceType', 'screenSize', 'userAgent', 'path', 'hostname', 'accessType', 'date', 'time', 'loggedAt', 'createdAt']);
      allow update, delete: if false;
    }
    match /settings/{id} { allow read: if active(); allow write: if admin(); }
    match /public_settings/institution {
      allow get: if true;
      allow create, update: if admin() &&
        request.resource.data.keys().hasOnly(['name', 'shortName', 'appName', 'typeLabel', 'city', 'country', 'logoUrl', 'paletteKey', 'primaryColor', 'accentColor', 'educationType', 'schoolCycles', 'schoolGradeScales']) &&
        request.resource.data.educationType in ['vocational', 'private_school'] &&
        request.resource.data.schoolCycles is list &&
        request.resource.data.schoolCycles.hasOnly(['Primaire', 'Collège', 'Lycée']) &&
        request.resource.data.name is string && request.resource.data.logoUrl is string;
      allow list, delete: if false;
    }
    // Only the semester and operational year are public, never settings/app.
    match /public_settings/schedule {
      function matchesActiveSettings() {
        let settings = getAfter(/databases/$(database)/documents/settings/app).data;
        let semester = settings.get('activeSemester', 'S1') == 'S2' ? 'S2' : 'S1';
        return request.resource.data.activeSemester == semester &&
          request.resource.data.operationalAcademicYear == settings.get('operationalAcademicYear', '2025-2026');
      }
      allow get: if true;
      allow create, update: if admin() &&
        request.resource.data.keys().hasOnly(['activeSemester', 'operationalAcademicYear']) &&
        request.resource.data.activeSemester in ['S1', 'S2'] &&
        request.resource.data.operationalAcademicYear is string &&
        request.resource.data.operationalAcademicYear.matches('[0-9]{4}-[0-9]{4}') && matchesActiveSettings();
      allow list, delete: if false;
    }
    match /operations/{id} { allow read, write: if admin(); }
    match /academic_year_backups/{backup}/{document=**} { allow read, write: if admin(); }
    match /tokens/{id} { allow read, write: if admin(); }
    function moduleFor(name) {
      return {'students': 'students', 'teachers': 'teachers', 'grades': 'grades', 'schedules': 'schedules',
        'modules': 'modules', 'attendance_stagiaires': 'attendance_students', 'attendance_formateurs': 'attendance_teachers',
        'payments': 'finance', 'salaries': 'finance', 'expenses': 'finance', 'receipt_counters': 'finance',
        'continuousTrainings': 'continuous', 'continuousTrainingTypes': 'continuous', 'ctStudents': 'continuous', 'ctSessions': 'continuous'}.get(name, '');
    }
    function validPortalTeacherToken(teacherId, token) {
      return teacherId is string && token is string && token.size() > 0 &&
        get(/databases/$(database)/documents/teachers/$(teacherId)).data.tokenAttendance == token;
    }
    function validPortalGradeToken(teacherId, token, studentId) {
      let teacher = get(/databases/$(database)/documents/teachers/$(teacherId)).data;
      let student = get(/databases/$(database)/documents/students/$(studentId)).data;
      return teacherId is string && token is string && token.size() > 0 &&
        teacher.tokenGrades == token && student.major in teacher.groups &&
        (!(student.get('diploma', '') in ['Primaire', 'Collège', 'Lycée']) ||
          (student.diploma in teacher.get('diplomas', []) && student.year in teacher.get('years', [])));
    }
    match /attendance_formateurs/{id} {
      allow create, update: if validPortalTeacherToken(request.resource.data.teacherId, request.resource.data.tokenAttendance);
      allow delete: if validPortalTeacherToken(resource.data.teacherId, resource.data.tokenAttendance);
    }
    match /attendance_stagiaires/{id} {
      allow create, update: if validPortalTeacherToken(request.resource.data.formateurId, request.resource.data.tokenAttendance);
      allow delete: if validPortalTeacherToken(resource.data.formateurId, resource.data.tokenAttendance);
    }
    match /grades/{id} {
      allow get: if request.auth != null &&
        exists(/databases/$(database)/documents/student_grade_sessions/$(request.auth.uid)) &&
        validStudentGradeSession(id);
      allow get: if request.auth != null &&
        exists(/databases/$(database)/documents/teacher_grade_sessions/$(request.auth.uid)) &&
        validTeacherGradeSession(id);
      allow create, update: if validPortalGradeToken(request.resource.data.teacherId, request.resource.data.tokenGrades, id);
    }
    function validTeacherGradeSession(studentId) {
      let session = get(/databases/$(database)/documents/teacher_grade_sessions/$(request.auth.uid)).data;
      return session.createdAt + duration.value(10, 'm') > request.time &&
        validPortalGradeToken(session.teacherId, session.tokenGrades, studentId);
    }
    function validStudentGradeSession(studentId) {
      let session = get(/databases/$(database)/documents/student_grade_sessions/$(request.auth.uid)).data;
      return session.studentId == studentId &&
        session.createdAt + duration.value(10, 'm') > request.time &&
        get(/databases/$(database)/documents/students/$(studentId)).data.token == session.token;
    }
    match /student_grade_sessions/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasAll(['studentId', 'token', 'createdAt']) &&
        request.resource.data.keys().hasOnly(['studentId', 'token', 'createdAt']) &&
        request.resource.data.studentId is string && request.resource.data.token is string &&
        request.resource.data.token.size() > 0 && request.resource.data.createdAt == request.time &&
        get(/databases/$(database)/documents/students/$(request.resource.data.studentId)).data.token == request.resource.data.token;
      allow list: if false;
    }
    match /teacher_grade_sessions/{uid} {
      allow get, delete: if request.auth != null && request.auth.uid == uid;
      allow create, update: if request.auth != null && request.auth.uid == uid &&
        request.resource.data.keys().hasOnly(['teacherId', 'tokenGrades', 'createdAt']) &&
        request.resource.data.teacherId is string && request.resource.data.tokenGrades is string &&
        request.resource.data.tokenGrades.size() > 0 && request.resource.data.createdAt == request.time &&
        get(/databases/$(database)/documents/teachers/$(request.resource.data.teacherId)).data.tokenGrades == request.resource.data.tokenGrades;
      allow list: if false;
    }
    match /{name}/{id} {
      allow read: if moduleFor(name) != '' && permitted(moduleFor(name), 'view');
      allow write: if moduleFor(name) != '' && permitted(moduleFor(name), 'edit');
    }
    // Public schedule publications: possession of a random link permits reading,
    // never enumeration or writing. The original collections keep their rules.
    match /schedule_share_scopes/{scopeId} {
      allow get: if permitted('schedules', 'view');
      allow create: if permitted('schedules', 'view') && scopeId.matches('[a-f0-9]{64}') &&
        request.resource.data.keys().hasOnly(['token']) && request.resource.data.token is string &&
        request.resource.data.token.matches('[A-Za-z0-9_-]{43}');
      allow list, update, delete: if false;
    }
    match /public_schedules/{token} {
      function validToken() { return token.matches('[A-Za-z0-9_-]{43}'); }
      function validPublication() {
        let p = request.resource.data;
        return p.keys().hasOnly(['diploma', 'filiere', 'annee', 'academicYear', 'semester', 'publishedAt']) &&
          p.diploma is string && p.diploma.size() <= 240 && p.filiere is string && p.filiere.size() <= 240 &&
          p.annee is string && p.annee.size() > 0 && p.annee.size() <= 120 && p.academicYear is string && p.academicYear.matches('[0-9]{4}-[0-9]{4}') &&
          p.semester in ['S1', 'S2'] && p.publishedAt == request.time;
      }
      allow get: if validToken();
      allow list: if false;
      allow create, update: if validToken() && permitted('schedules', 'view') && validPublication();
      allow delete: if permitted('schedules', 'edit');
      match /sessions/{sessionId} {
        function validSession() {
          let s = request.resource.data;
          return s.keys().hasOnly(['day', 'time', 'type', 'room', 'module', 'teacherName']) &&
            s.day in ['Lundi', 'Mardi', 'Mercredi', 'Jeudi', 'Vendredi', 'Samedi', 'Dimanche'] &&
            s.time is string && s.time.size() <= 40 && s.type is string && s.type.size() <= 40 &&
            s.room is string && s.room.size() <= 500 && s.module is string && s.module.size() <= 10000 &&
            s.teacherName is string && s.teacherName.size() <= 500;
        }
        allow read: if validToken() && (permitted('schedules', 'view') || exists(/databases/$(database)/documents/public_schedules/$(token)));
        allow create, update: if validToken() && permitted('schedules', 'view') && validSession() &&
          existsAfter(/databases/$(database)/documents/public_schedules/$(token));
        allow delete: if permitted('schedules', 'view');
      }
    }

    // Default deny, including unauthenticated legacy bearer-link portals.
    match /{document=**} { allow read, write: if false; }
  }
}
